{"version":"2.0","class":"dataset","label":"14710: Consumer price index (2025=100), by month","source":"Statistics Norway","updated":"2026-10-09T06:00:00Z","note":["This table replaces [table 08183](https://www.ssb.no/en/statbank/table/08183).\n\nAs of 2026 the reference year is 2025=100. Rates of change calculated from the 2015=100 series may differ from published rates of change before 2026 with another reference year. The deviations are mainly due to rounding effects. [See the completed table 08183](https://www.ssb.no/en/statbank/table/08183) for published rates of change for the period 2017 to 2025 with 2015=100. As of January 2016 UNs' consumer classification COICOP2018 is applied."],"role":{"time":["Tid"],"metric":["ContentsCode"]},"id":["ContentsCode","Tid"],"size":[1,2],"dimension":{"ContentsCode":{"label":"contents","category":{"index":{"KpiIndMnd":0},"label":{"KpiIndMnd":"Consumer Price Index"},"unit":{"KpiIndMnd":{"base":"index","decimals":1}}},"extension":{"elimination":false,"refperiod":{"KpiIndMnd":"Month"},"show":"value","measuringType":{"KpiIndMnd":"Average"},"priceType":{"KpiIndMnd":"NotApplicable"},"adjustment":{"KpiIndMnd":"None"},"basePeriod":{"KpiIndMnd":"2025"},"alternativeText":{"KpiIndMnd":"Consumer Price Index"}},"link":{"describedby":[{"extension":{"KpiIndMnd":"urn:ssb:conceptvariable:vardok:2755"}}]}},"Tid":{"label":"month","category":{"index":{"2025M09":0,"2026M09":1},"label":{"2025M09":"2025M09","2026M09":"2026M09"}},"extension":{"elimination":false,"show":"code"}}},"extension":{"noteMandatory":{"0":true},"px":{"infofile":"None","tableid":"14710","decimals":1,"official-statistics":true,"aggregallowed":false,"copyright":false,"language":"en","contents":"14710: Consumer price index (2025=100),","descriptiondefault":false,"heading":["ContentsCode","Tid"],"stub":[],"matrix":"14710","subject-code":"pp","subject-area":"Prices and price indices"},"discontinued":null},"value":[100.6,104]}