{"version":"2.0","class":"dataset","label":"05692: Skilsmisser, etter år","source":"Statistisk sentralbyrå","updated":"2026-05-12T06:00:00Z","note":["For åra 1971-1985 gjelder  tallet skilsmisser der minst en av partene var bosatt i Norge. Fra 1986-2024 gjelder tallet skilsmisser der mannen var bosatt i Norge når skilsmissen ble innvilget. Fra og med 2025 gjelder skilsmisser der eldste ektefelle var bosatt i Norge."],"role":{"time":["Tid"],"metric":["ContentsCode"]},"id":["ContentsCode","Tid"],"size":[1,2],"dimension":{"ContentsCode":{"label":"statistikkvariabel","category":{"index":{"Skilsmisse":0},"label":{"Skilsmisse":"Skilsmisser"},"unit":{"Skilsmisse":{"base":"antall","decimals":0}}},"extension":{"elimination":false,"refperiod":{"Skilsmisse":"31.12."},"show":"value","measuringType":{"Skilsmisse":"Flow"},"priceType":{"Skilsmisse":"NotApplicable"},"adjustment":{"Skilsmisse":"None"},"alternativeText":{"Skilsmisse":"Skilsmisser"}}},"Tid":{"label":"år","category":{"index":{"2024":0,"2025":1},"label":{"2024":"2024","2025":"2025"}},"extension":{"elimination":false,"show":"code"}}},"extension":{"px":{"infofile":"None","tableid":"05692","decimals":0,"official-statistics":true,"aggregallowed":true,"copyright":false,"language":"no","contents":"05692: Skilsmisser,","descriptiondefault":false,"heading":["ContentsCode","Tid"],"stub":[],"matrix":"05692","subject-code":"be","subject-area":"Befolkning"},"discontinued":null},"value":[8350,8441]}