{"version":"2.0","class":"dataset","label":"14710: Konsumprisindeks (2025=100), etter måned","source":"Statistisk sentralbyrå","updated":"2026-10-09T06:00:00Z","note":["Denne tabellen erstatter [tabell 08183](https://www.ssb.no/statbank/table/08183).\n\nF.o.m. 2026 er referanseår 2025=100. Endringstall beregnet fra serier med 2025=100 kan avvike fra endringstall publisert før 2026 med annet referanseår. Avvikene skyldes i all hovedsak avrundingseffekter. [Se den avsluttede tabellen 08183](https://www.ssb.no/statbank/table/08183) for publiserte endringstall for perioden 2017 t.o.m. 2025 med 2015=100. Fra januar 2026 gjelder FNs konsumklassifisering COICOP2018."],"role":{"time":["Tid"],"metric":["ContentsCode"]},"id":["ContentsCode","Tid"],"size":[1,1],"dimension":{"ContentsCode":{"label":"statistikkvariabel","category":{"index":{"KpiIndMnd":0},"label":{"KpiIndMnd":"Konsumprisindeks"},"unit":{"KpiIndMnd":{"base":"indeks","decimals":1}}},"extension":{"elimination":false,"refperiod":{"KpiIndMnd":"Måned"},"show":"value","measuringType":{"KpiIndMnd":"Average"},"priceType":{"KpiIndMnd":"NotApplicable"},"adjustment":{"KpiIndMnd":"None"},"basePeriod":{"KpiIndMnd":"2025"},"alternativeText":{"KpiIndMnd":"Konsumprisindeks"}},"link":{"describedby":[{"extension":{"KpiIndMnd":"urn:ssb:conceptvariable:vardok:2755"}}]}},"Tid":{"label":"måned","category":{"index":{"2026M09":0},"label":{"2026M09":"2026M09"}},"extension":{"elimination":false,"show":"code"}}},"extension":{"noteMandatory":{"0":true},"px":{"infofile":"None","tableid":"14710","decimals":1,"official-statistics":true,"aggregallowed":false,"copyright":false,"language":"no","contents":"14710: Konsumprisindeks (2025=100),","descriptiondefault":false,"heading":["ContentsCode","Tid"],"stub":[],"matrix":"14710","subject-code":"pp","subject-area":"Priser og prisindekser"},"discontinued":null},"value":[104]}