t":"urn:ssb:conceptvariable:vardok:1116"}}],"related":[{"extension":{"relation":"definitions","category":"Sysselsatte","metaid":"urn:ssb:conceptvariable:vardok:1116"},"href":"https://www.ssb.no/a/metadata/conceptvariable/vardok/1116/en","label":"Variable definition of Employed persons (1 000 persons)","type":"text/html"},{"extension":{"relation":"definitions","category":"Prosent","metaid":"urn:ssb:conceptvariable:vardok:1116"},"href":"https://www.ssb.no/a/metadata/conceptvariable/vardok/1116/en","label":"Variable definition of Employed persons (per cent)","type":"text/html"}]}},"Tid":{"label":"year","category":{"index":{"2011":0,"2012":1,"2013":2,"2014":3,"2015":4,"2016":5,"2017":6,"2018":7,"2019":8,"2020":9,"2021":10,"2022":11,"2023":12,"2024":13,"2025":14},"label":{"2011":"2011","2012":"2012","2013":"2013","2014":"2014","2015":"2015","2016":"2016","2017":"2017","2018":"2018","2019":"2019","2020":"2020","2021":"2021","2022":"2022","2023":"2023","2024":"2024","2025":"2025"}},"extension":{"elimination":false,"show":"code","codelists":[]}}},"extension":{"px":{"infofile":"None","tableid":"09788","decimals":0,"official-statistics":true,"aggregallowed":false,"copyright":false,"language":"en","contents":"09788: Employed persons. Annual average,","descriptiondefault":false,"heading":["ContentsCode","Tid"],"stub":["Kjonn","Yrke"],"matrix":"09788","subject-code":"al","subject-area":"Labour market and earnings"}},"value":[]}