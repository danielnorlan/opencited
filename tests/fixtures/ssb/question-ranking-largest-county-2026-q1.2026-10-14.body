{"version":"2.0","class":"dataset","label":"06913: Population and population changes, by region and year","source":"Statistics Norway","updated":"2026-04-15T06:00:00Z","note":["[Documentation (in Norwegian)](https://www.ssb.no/befolkning/artikler-og-publikasjoner/dokumentasjon-av-kommunetabeller-over-folkemengdens-bevegelse-1906-1968).","The figures available under 'Municipalities 2024, aggregated time series' are sums of municipalities according to the borders in each year. Please be aware of many municipality changes and border adjustments in the early 1960s, see  [Endringer i kommuneinndelingen 1951-2008](https://www.ssb.no/offentlig-sektor/kommunekatalog/endringer-i-de-regionale-inndelingene/_attachment/82590?_ts=13adfbdae28).","[See list over changes in regional classifications](https://www.ssb.no/offentlig-sektor/kommunekatalog/endringer-i-de-regionale-inndelingene) (in Norwegian).\n"],"role":{"time":["Tid"],"geo":["Region"],"metric":["ContentsCode"]},"id":["Region","ContentsCode","Tid"],"size":[15,1,1],"dimension":{"Region":{"label":"region","category":{"index":{"31":0,"32":1,"03":2,"34":3,"33":4,"39":5,"40":6,"42":7,"11":8,"46":9,"15":10,"50":11,"18":12,"55":13,"56":14},"label":{"31":"Østfold","32":"Akershus","03":"Oslo - Oslove","34":"Innlandet","33":"Buskerud","39":"Vestfold","40":"Telemark","42":"Agder","11":"Rogaland","46":"Vestland","15":"Møre og Romsdal","50":"Trøndelag - Trööndelage","18":"Nordland - Nordlánnda","55":"Troms - Romsa - Tromssa","56":"Finnmark - Finnmárku - Finmarkku"},"note":{"03":["Ved grenseregulering 1.1 1980 ble 53 personer overført fra 0231 Skedsmo til 0301 Oslo."],"11":["1.1.1964 ble 24 personer overført fra 1154 Skjold (Flatnæs-Buvik-området) til 1216 Sveio. 1.1.2002 ble 1214 Ølen overført fra Hordaland  til Rogaland fylke, som 1159 Ølen."],"15":["1 January 2019, the municipality 1567 Rindal was moved from Møre og Romsdal to Trøndelag. 1 January 2020, the municipality 1571 Halsa was moved from Møre og Romsdal to Trøndelag. 1 January 2020, the municipality 1444 Hornindal was moved from Sogn og Fjordane to Møre og Romsdal.","Ved grenseregulering 1. januar 2002 ble ca. 380 personer overført fra 1514 Sande kommune til 1511 Vanylven kommune. Ved grenseregulering 1. januar 2008 vart 4 innbyggjarar flytta over frå 1567 Rindal til 1612 Hemne."],"50":["1 January 2019, the municipality 1567 Rindal was moved from Møre og Romsdal to Trøndelag. 1 January 2020, the municipality 1571 Halsa was moved from Møre og Romsdal to Trøndelag."],"18":["1 January 2020, the municipality 1852 Tjeldsund was moved from Nordland to Troms og Finnmark.","1.1.2000 ble 102 personer overført fra 1911 Kvæfjord til 1870 Sortland."]}},"extension":{"elimination":false,"show":"code_value"},"link":{"describedby":[{"extension":{"Region":"urn:ssb:classification:klass:104 urn:ssb:classification:klass:131"}}]}},"ContentsCode":{"label":"contents","category":{"index":{"Folkemengde":0},"label":{"Folkemengde":"Population 1 January"},"unit":{"Folkemengde":{"base":"persons","decimals":0}}},"extension":{"elimination":false,"refperiod":{"Folkemengde":"1.1."},"show":"value","measuringType":{"Folkemengde":"Stock"},"priceType":{"Folkemengde":"NotApplicable"},"adjustment":{"Folkemengde":"None"},"alternativeText":{"Folkemengde":"Population 1 January"}}},"Tid":{"label":"year","category":{"index":{"2026":0},"label":{"2026":"2026"}},"extension":{"elimination":false,"show":"code"}}},"extension":{"px":{"infofile":"None","tableid":"06913","decimals":0,"official-statistics":true,"aggregallowed":true,"copyright":false,"language":"en","contents":"06913: Population and population changes,","descriptiondefault":false,"heading":["ContentsCode","Tid"],"stub":["Region"],"matrix":"06913","subject-code":"be","subject-area":"Population"},"discontinued":null},"value":[316448,749207,728714,379488,272981,259332,177923,323930,508922,658342,273169,489166,243272,171218,75288]}