{"version":"2.0","class":"dataset","label":"05692: Skilsmisser, etter ekteskapets varighet og år","source":"Statistisk sentralbyrå","updated":"2026-05-12T06:00:00Z","note":["For åra 1971-1985 gjelder  tallet skilsmisser der minst en av partene var bosatt i Norge. Fra 1986-2024 gjelder tallet skilsmisser der mannen var bosatt i Norge når skilsmissen ble innvilget. Fra og med 2025 gjelder skilsmisser der eldste ektefelle var bosatt i Norge."],"role":{"time":["Tid"],"metric":["ContentsCode"]},"id":["VarighetIAar","ContentsCode","Tid"],"size":[7,1,1],"dimension":{"VarighetIAar":{"label":"ekteskapets varighet","category":{"index":{"00-02":0,"03-04":1,"05-09":2,"10-14":3,"15-19":4,"20-24":5,"025+":6},"label":{"00-02":"0-2 år","03-04":"3-4 år","05-09":"5-9 år","10-14":"10-14 år","15-19":"15-19 år","20-24":"20-24 år","025+":"25 år eller eldre"}},"extension":{"elimination":false,"show":"value"}},"ContentsCode":{"label":"statistikkvariabel","category":{"index":{"Skilsmisse":0},"label":{"Skilsmisse":"Skilsmisser"},"unit":{"Skilsmisse":{"base":"antall","decimals":0}}},"extension":{"elimination":false,"refperiod":{"Skilsmisse":"31.12."},"show":"value","measuringType":{"Skilsmisse":"Flow"},"priceType":{"Skilsmisse":"NotApplicable"},"adjustment":{"Skilsmisse":"None"},"alternativeText":{"Skilsmisse":"Skilsmisser"}}},"Tid":{"label":"år","category":{"index":{"2025":0},"label":{"2025":"2025"}},"extension":{"elimination":false,"show":"code"}}},"extension":{"px":{"infofile":"None","tableid":"05692","decimals":0,"official-statistics":true,"aggregallowed":true,"copyright":false,"language":"no","contents":"05692: Skilsmisser,","descriptiondefault":false,"heading":["ContentsCode","Tid"],"stub":["VarighetIAar"],"matrix":"05692","subject-code":"be","subject-area":"Befolkning"},"discontinued":null},"value":[573,734,1898,1776,1356,945,1059]}