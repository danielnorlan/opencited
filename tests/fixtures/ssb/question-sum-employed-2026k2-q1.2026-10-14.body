{"version":"2.0","class":"dataset","label":"03778: Sysselsatte (AKU), etter alder, kjønn og kvartal","source":"Statistisk sentralbyrå","updated":"2026-08-13T06:00:00Z","note":["Det skjedde en større omlegging av AKU fra januar 2006 ved blant annet å senke aldersgrensen fra 16 til 15 år. Se [Om statistikken](https://www.ssb.no/aku) for mer informasjon.","Fra 2018 ble det tatt i bruk en ny estimeringsmetode, og tallene ble revidert tilbake til 2006. For mer informasjon, se egen [artikkel](https://www.ssb.no/arbeid-og-lonn/artikler-og-publikasjoner/ny-metode-gir-bedre-aku-tall).","Det ble gjennomført en større omlegging av AKU fra januar 2021, se [Om statistikken](https://www.ssb.no/aku) for mer informasjon om endringene som ble foretatt. Som følge av omleggingen ble antallet personer 15-74 år i ny AKU redusert med 26 700. Omleggingen i 2021 medførte videre brudd i antallet sysselsatte beregnet til 21 900 og brudd i antallet arbeidsledige beregnet til 5 400 (begge estimater, sistnevnte ikke signifikant). Antallet personer utenfor arbeidssyrken ble dermed redusert med 54 000 (residualbestemt). I 2021 opphørte også bruken av indirekte intervju, altså at medlemmer i husholdningen kunne svare på vegne av andre husholdningsmedlemmer (i praksis ofte de yngste). Denne endringen ser ut til å ha gitt brudd i enkelte variabler mellom 2020 og 2021 for de yngste aldersgruppene."],"role":{"time":["Tid"],"metric":["ContentsCode"]},"id":["Alder","Kjonn","ContentsCode","Tid"],"size":[1,2,1,1],"dimension":{"Alder":{"label":"alder","category":{"index":{"15-74":0},"label":{"15-74":"15-74 år"}},"extension":{"elimination":true,"eliminationValueCode":"15-74","show":"value"}},"Kjonn":{"label":"kjønn","category":{"index":{"2":0,"1":1},"label":{"2":"Kvinner","1":"Menn"}},"extension":{"elimination":false,"show":"value"},"link":{"describedby":[{"extension":{"Kjonn":"urn:ssb:classification:klass:2"}}]}},"ContentsCode":{"label":"statistikkvariabel","category":{"index":{"Sysselsatte":0},"label":{"Sysselsatte":"Sysselsatte (1 000 personer)"},"unit":{"Sysselsatte":{"base":"1 000 personer","decimals":0}}},"extension":{"elimination":false,"refperiod":{"Sysselsatte":"Løpende referanseuker"},"show":"value","measuringType":{"Sysselsatte":"Average"},"priceType":{"Sysselsatte":"NotApplicable"},"adjustment":{"Sysselsatte":"None"},"alternativeText":{"Sysselsatte":"Sysselsatte (1 000 personer)"}},"link":{"describedby":[{"extension":{"Sysselsatte":"urn:ssb:conceptvariable:vardok:1116"}}]}},"Tid":{"label":"kvartal","category":{"index":{"2026K2":0},"label":{"2026K2":"2026K2"}},"extension":{"elimination":false,"show":"code"}}},"extension":{"px":{"infofile":"None","tableid":"03778","decimals":0,"official-statistics":true,"aggregallowed":false,"copyright":false,"language":"no","contents":"03778: Sysselsatte (AKU),","descriptiondefault":false,"heading":["ContentsCode","Tid"],"stub":["Alder","Kjonn"],"matrix":"03778","subject-code":"al","subject-area":"Arbeid og lønn"},"discontinued":null},"value":[1382,1553]}