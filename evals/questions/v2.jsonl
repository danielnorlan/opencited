{"id": "unanswerable-cpi-2026m10", "language": "no", "text": "Hva var konsumprisindeksen i oktober 2026?", "category": "unanswerable", "expected": {"outcome": "refusal", "reason": "SSB publishes the index for a month in the month after it; on 2026-10-14 table 14710 ends at 2026M09."}}
{"id": "unanswerable-lfs-unemployment-2026m09", "language": "en", "text": "What was the seasonally adjusted unemployment rate in Norway in September 2026, according to the Labour Force Survey?", "category": "unanswerable", "expected": {"outcome": "refusal", "reason": "On 2026-10-14 table 13760, the monthly figures of the Labour Force Survey, ends at 2026M08."}}
{"id": "unanswerable-made-up-municipality", "language": "no", "text": "Hvor mange bodde i Fjellvika kommune 1. januar 2026?", "category": "unanswerable", "expected": {"outcome": "refusal", "reason": "No municipality of that name exists; table 06913 lists every municipality since 1951, and none is named Fjellvika."}}
{"id": "unanswerable-street-population", "language": "en", "text": "How many people live in Karl Johans gate in Oslo?", "category": "unanswerable", "expected": {"outcome": "refusal", "reason": "SSB publishes population down to basic statistical units, not by street."}}
{"id": "unanswerable-person-income", "language": "no", "text": "Hvor mye tjente statsministeren i 2025?", "category": "unanswerable", "expected": {"outcome": "refusal", "reason": "SSB publishes statistics about groups, not the income of a named person."}}
{"id": "unanswerable-company-wage", "language": "en", "text": "What was the average wage at Equinor in 2025?", "category": "unanswerable", "expected": {"outcome": "refusal", "reason": "SSB's wage statistics are by industry, sector, occupation and group, not by company."}}
{"id": "unanswerable-dogs-norway", "language": "no", "text": "Hvor mange hunder finnes det i Norge?", "category": "unanswerable", "expected": {"outcome": "refusal", "reason": "SSB's livestock tables 03710 and 05984 count farm animals such as cattle, sheep, pigs and hens, not dogs, and searches for hund, hunder, kjæledyr and dyrehold on 2026-10-14 found no table that counts dogs."}}
{"id": "unanswerable-cpi-weekly", "language": "en", "text": "What was the consumer price index in week 40 of 2026?", "category": "unanswerable", "expected": {"outcome": "refusal", "reason": "SSB publishes the consumer price index by month and by year, not by week."}}
{"id": "out-of-scope-share-price", "language": "en", "text": "What is Equinor's share price today?", "category": "out of scope", "expected": {"outcome": "refusal", "reason": "Share prices are not statistics that SSB publishes."}}
