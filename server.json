{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.danielnorlan/opencited",
  "title": "OpenCited",
  "description": "Official statistics from Statistics Norway (SSB), with provenance for every value.",
  "repository": {
    "url": "https://github.com/danielnorlan/opencited",
    "source": "github"
  },
  "version": "0.1.0.dev0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "opencited",
      "version": "0.1.0.dev0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
